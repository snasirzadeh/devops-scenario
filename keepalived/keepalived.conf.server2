global_defs {
    router_id SERVER2
    enable_script_security
    script_user debian
}

vrrp_script check_web {
    script "/usr/local/bin/check-web.sh"
    interval 2
    timeout 2
    fall 2
    rise 2
    weight -60
}

vrrp_instance VI_1 {
    state BACKUP
    interface ens18

    virtual_router_id 51
    priority 100
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass password
    }

    virtual_ipaddress {
        192.168.1.10/24
    }

    track_script {
        check_web
    }
}

