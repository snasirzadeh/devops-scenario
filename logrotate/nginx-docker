/home/debian/devops-scenario/logs/*.log {
    daily
    minage 3
    rotate 10
    dateext
    missingok
    compress
    delaycompress
    notifempty
    create 640 101 101
    sharedscripts

    postrotate
        cd /home/debian/devops-scenario \
            && /usr/bin/docker compose kill -s USR1 nginx
    endscript
}
